{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Project manifest, stored in `dea.yaml`.",
  "properties": {
    "defaultEnvironment": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "schemaVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "name",
    "schemaVersion"
  ],
  "title": "Manifest",
  "type": "object"
}
