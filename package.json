{
  "name": "dea",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write --no-error-on-unmatched-pattern .github apps crates packages sdks testing tools website \"*.{js,json,md,yaml}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern .github apps crates packages sdks testing tools website \"*.{js,json,md,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
