{
  "extends": ["@tsconfig/svelte/tsconfig.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["svelte", "vite/client", "@testing-library/jest-dom/vitest"],
    "allowArbitraryExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "$app/*": ["./src/app/*"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "vitest.setup.ts"
  ]
}
