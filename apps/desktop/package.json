{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json && tsc -p tests/e2e/tsconfig.json",
    "test": "vitest run",
    "schema:manifest": "ts-json-schema-generator --path src/app/contributions/manifest-data.ts --type ManifestData --tsconfig tsconfig.app.json --no-type-check -o src/app/contributions/manifest.schema.json && prettier --write src/app/contributions/manifest.schema.json",
    "e2e": "wdio run tests/e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@dea/ui": "workspace:*",
    "@lucide/svelte": "^1.74.0",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.12",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "@wdio/cli": "^10.2.0",
    "@wdio/globals": "^10.2.0",
    "@wdio/local-runner": "^10.2.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^10.2.0",
    "@wdio/types": "^10.2.0",
    "jsdom": "^31.0.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webdriverio": "^10.2.0"
  }
}
